# Public client configuration. Never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_KORTEX_MODE=supabase

# Show Apple sign-in only after the Apple provider is configured in Supabase.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false

# Development fixtures are opt-in. Change mode to demo only for local UI testing.
